[Unit]
Description=WeChat iLink bridge daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 改成你的部署目录
WorkingDirectory=/home/your-user/wechat-bridge
ExecStart=/usr/bin/python3 /home/your-user/wechat-bridge/daemon.py
# 若部署环境必须走出境代理：systemd 单元拿不到 shell 的环境变量，
# 需要用 EnvironmentFile 显式注入 http_proxy/https_proxy，例如：
# EnvironmentFile=/home/your-user/wechat-bridge/proxy.env
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/your-user/wechat-bridge/logs/daemon.log
StandardError=append:/home/your-user/wechat-bridge/logs/daemon.log
# 注意：登录过期时 daemon 会以退出码 0 干净退出（等外部调度器通知你重新扫码），
# 不要改成 Restart=always，否则过期后会无限重启刷日志。

[Install]
WantedBy=multi-user.target
